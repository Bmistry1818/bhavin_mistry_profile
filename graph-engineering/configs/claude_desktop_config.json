{
  "mcpServers": {
    "graph_engineering": {
      "command": "/absolute/path/to/graph-engineering/.venv/bin/graph-memory-mcp",
      "args": ["--profile", "all"],
      "env": {
        "OBSIDIAN_VAULT_PATH": "/absolute/path/to/your/vault",
        "GRAPH_REPO_ROOT": "/absolute/path/to/your/codebase",
        "GRAPH_ALLOW_WRITE": "0"
      }
    }
  }
}
